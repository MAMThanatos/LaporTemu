<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LaporTemu" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/bg_light</item>

        <!-- Status Bar - transparent to show gradient -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Customize colors for Material Components -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Bottom Navigation Active Indicator -->
        <item name="colorPrimaryContainer">@color/primary_ultra_light</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <!-- Text Field box stroke color -->
        <item name="colorControlActivated">@color/primary</item>
    </style>

    <style name="Theme.LaporTemu" parent="Base.Theme.LaporTemu" />

    <!-- Splash Theme - no status bar -->
    <style name="Theme.LaporTemu.Splash" parent="Base.Theme.LaporTemu">
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>